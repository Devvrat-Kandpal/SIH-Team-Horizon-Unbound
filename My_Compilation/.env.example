# Optional Team-compatible Supabase persistence.
# Use the existing Team Supabase project values when access is approved.
# NOTE: Placeholders below — always substitute your own project URL + key, never these.
SUPABASE_ENABLED=true
# e.g. https://<your-project-ref>.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use a publishable (anon) key for demo ingestion OR the service_role key for backend ingestion.
# NEVER commit the service_role (secret) key to any repository or frontend bundle.
SUPABASE_KEY=<your_supabase_anon_or_service_role_key>
# Comma-separated browser origins for a future separated frontend deployment.
FRONTEND_ORIGINS=http://127.0.0.1:8000
